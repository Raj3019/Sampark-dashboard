# ── Google Sheets API (Service Account) ──────────────────────────────────────
# Step-by-step setup: see .env.local.example for full instructions

# The ID from your sheet URL:
# https://docs.google.com/spreadsheets/d/  THIS_PART  /edit
GOOGLE_SHEET_ID=SHEET ID

# The tab name exactly as shown in Google Sheets (bottom tab label)
GOOGLE_SHEET_NAME=SHEET NAME

# From your service account JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=app@projectName.iam.gserviceaccount.com

# Paste the private_key value from the JSON — keep it on ONE line with \n for newlines
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----KEY-----END PRIVATE KEY-----\n

# AI (Groq via Vercel AI SDK)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

